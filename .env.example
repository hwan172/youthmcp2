# 온통청년(youthcenter.go.kr) OPEN API 인증키 — 2025 개편 신규 API
# 발급: youthcenter.go.kr 로그인 → 마이페이지 → OPEN API → 인증키 발급 신청(담당자 승인).
# 인증방식: 쿼리파라미터 apiKeyNm=<키>  |  응답: rtnType=json 지정 시 JSON.
# 키 미설정 시 서버는 내장 코퍼스 기반 mock 으로 동작(응답에 is_mock=True 명시).

# 청년정책 목록 — /go/ythip/getPlcy  (정책 검색·자격판정에 사용)
#   미설정 시 구 단일키 YOUTHCENTER_API_KEY 로 폴백(하위호환).
YOUTHCENTER_API_KEY_POLICY=

# (선택) 정책소식 콘텐츠 게시판 — /go/ythip/getContent  (향후 '정책 뉴스' 툴 후보)
YOUTHCENTER_API_KEY_CONTENTS=

# (선택) 청년센터·청년공간 목록 — /go/ythip/getSpace  (향후 '주변 청년센터 안내' 툴 후보)
YOUTHCENTER_API_KEY_CENTERS=

# (선택) 서버 실행 설정 — 미설정 시 stdio / 0.0.0.0 / 8000
# MCP_TRANSPORT=http
# MCP_HOST=0.0.0.0
# MCP_PORT=8000

# (선택) 개인화 메모리 SQLite 경로 — 미설정 시 policy_memory.db
# MEMORY_DB_PATH=policy_memory.db
